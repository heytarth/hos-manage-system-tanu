# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# Local: mongodb://localhost:27017/hos-system
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/hos-system
MONGODB_URI=mongodb://localhost:27017/hos-system

# JWT Configuration
# Use a strong random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google Generative AI (Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Email Configuration (for future notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: AWS S3 (for image uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
