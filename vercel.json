{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "api/index.js"
    },
    {
      "src": "^/dashboard.html",
      "dest": "frontend/html/dashboard.html"
    },
    {
      "src": "^/(?!api).*",
      "dest": "api/index.js"
    }
  ]
}
